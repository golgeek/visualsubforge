index 96bc06a..3600977 100644
--- a/player/command.c
+++ b/player/command.c
@@ -6387,6 +6387,24 @@ static void cmd_track_remove(void *p)
         print_track_list(mpctx, "Track removed:");
 }
 
+static void cmd_vsf_replace_ass(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct track *track = mpctx->current_track[0][STREAM_SUB];
+    char *text = cmd->args[1].v.s;
+    if (!mpctx->playback_initialized || !track || !track->is_external ||
+        !track->d_sub || track->user_tid != cmd->args[0].v.i ||
+        strlen(text) > 4 * 1024 * 1024 ||
+        sub_control(track->d_sub, SD_CTRL_VSF_REPLACE_ASS, text) != CONTROL_OK)
+    {
+        cmd->success = false;
+        return;
+    }
+    redraw_subs(mpctx);
+    osd_changed(mpctx->osd);
+}
+
 static void cmd_track_reload(void *p)
 {
     struct mp_cmd_ctx *cmd = p;
@@ -7322,6 +7340,9 @@ const struct mp_cmd_def mp_cmds[] = {
     { "video-remove", cmd_track_remove, { {"id", OPT_INT(v.i), OPTDEF_INT(-1)} },
         .priv = &(const int){STREAM_VIDEO}, },
 
+    { "vsf-replace-ass", cmd_vsf_replace_ass,
+        { {"id", OPT_INT(v.i)}, {"document", OPT_STRING(v.s)} }, },
+
     { "sub-reload", cmd_track_reload, { {"id", OPT_INT(v.i), OPTDEF_INT(-1)} },
         .priv = &(const int){STREAM_SUB},
         .spawn_thread = true,
diff --git a/sub/dec_sub.c b/sub/dec_sub.c
index 118221a..3a84f9a 100644
--- a/sub/dec_sub.c
+++ b/sub/dec_sub.c
@@ -505,6 +505,12 @@ int sub_control(struct dec_sub *sub, enum sd_ctrl cmd, void *arg)
     mp_mutex_lock(&sub->lock);
     bool propagate = false;
     switch (cmd) {
+    case SD_CTRL_VSF_REPLACE_ASS:
+        // The same lock excludes render/get_text and packet decoding. The
+        // experiment only replaces a completely preloaded external ASS track.
+        if (sub->preload_attempted && sub->sd->preload_ok && !sub->new_segment)
+            propagate = true;
+        break;
     case SD_CTRL_SET_VIDEO_DEF_FPS:
         sub->video_fps = *(double *)arg;
         update_subtitle_speed(sub);

@@ -1019,6 +1019,29 @@ static int control(struct sd *sd, enum sd_ctrl cmd, void *arg)
 {
     struct sd_ass_priv *ctx = sd->priv;
     switch (cmd) {
+    case SD_CTRL_VSF_REPLACE_ASS: {
+        // Local experiment, not a general subtitle-editing API. In particular,
+        // option-driven decoder rebuilds still restore the original demux data.
+        char *text = arg;
+        if (ctx->is_converted || !ctx->ass_renderer || sd->opts->sub_clear_on_seek ||
+            !sd->opts->ass_enabled || ctx->clear_once ||
+            sd->shared_opts->ass_style_override[sd->order] == ASS_STYLE_OVERRIDE_STRIP)
+            return CONTROL_ERROR;
+        ASS_Track *replacement = ass_read_memory(ctx->ass_library, text, strlen(text), NULL);
+        if (!replacement)
+            return CONTROL_ERROR;
+        if (replacement->track_type != TRACK_TYPE_ASS || replacement->n_styles == 0) {
+            ass_free_track(replacement);
+            return CONTROL_ERROR;
+        }
+        // Parsing succeeds before replacing accepted render data. No library or
+        // renderer destruction: font caches survive, and mpv supplies frame PTS.
+        ass_free_track(ctx->ass_track);
+        ctx->ass_track = replacement;
+        ctx->ass_configured = false;
+        MP_VERBOSE(sd, "VSF preview replaced; renderer retained\n");
+        return CONTROL_OK;
+    }
     case SD_CTRL_SUB_STEP: {
         double *a = arg;
         long long ts = llrint(a[0] * 1000.0);

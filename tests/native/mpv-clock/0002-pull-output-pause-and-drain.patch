diff --git a/player/command.c b/player/command.c
index 96bc06a..91bf5cf 100644
--- a/player/command.c
+++ b/player/command.c
@@ -851,8 +851,11 @@ static int mp_property_audio_pts(void *ctx, struct m_property *prop,
                                 int action, void *arg)
 {
     MPContext *mpctx = ctx;
-    if (!mpctx->playback_initialized || mpctx->audio_status < STATUS_PLAYING ||
-        mpctx->audio_status >= STATUS_EOF)
+    // Decoder restarts and decoded EOF can coexist with queued audible audio.
+    // A non-flushing loop seek must not hide that output's timeline.
+    if (!mpctx->playback_initialized ||
+        ((mpctx->audio_status < STATUS_PLAYING || mpctx->audio_status >= STATUS_EOF) &&
+         (!mpctx->ao || !ao_is_playing(mpctx->ao))))
         return M_PROPERTY_UNAVAILABLE;
 
     return property_time(action, arg, playing_audio_pts(mpctx));
@@ -1439,7 +1442,8 @@ static int mp_property_eof_reached(void *ctx, struct m_property *prop,
     if (!mpctx->playback_initialized)
         return M_PROPERTY_UNAVAILABLE;
     bool eof = mpctx->video_status == STATUS_EOF &&
-               mpctx->audio_status == STATUS_EOF;
+               mpctx->audio_status == STATUS_EOF &&
+               (!mpctx->ao || !ao_is_playing(mpctx->ao));
     return m_property_bool_ro(action, arg, eof);
 }
 

@@ -460,12 +464,21 @@ void ao_set_paused(struct ao *ao, bool paused, bool eof)
 // and ao_start() was called. This returns true even if playback was logically
 // paused. On false, EOF was reached, or an underrun happened, or ao_reset()
 // was called.
+static bool is_playing_locked(struct ao *ao)
+{
+    struct buffer_state *p = ao->buffer_state;
+    int64_t now = p->paused ? p->pause_started_ns : mp_time_ns();
+    // A pull callback can run ahead of presentation (notably AVFoundation).
+    // Exhausting the source queue does not mean the device has drained.
+    return p->playing || (!ao->driver->write && p->end_time_ns > now);
+}

diff --git a/audio/queued_pts.c b/audio/queued_pts.c
new file mode 100644
index 0000000..5e4414a
--- /dev/null
+++ b/audio/queued_pts.c
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Experimental VSF audio timing change for mpv.
+
+#include <math.h>
+
+#include "common/common.h"
+#include "queued_pts.h"
+
+static bool known(double pts)
+{
+    return pts != MP_NOPTS_VALUE && isfinite(pts);
+}
+
+static int index_at(const struct mp_queued_pts *clock, int offset)
+{
+    return (clock->first + offset) % MP_QUEUED_PTS_CAPACITY;
+}
+
+void mp_queued_pts_reset(struct mp_queued_pts *clock)
+{
+    clock->first = clock->count = 0;
+    clock->written = 0;
+}
+
+void mp_queued_pts_append(struct mp_queued_pts *clock, double duration,
+                          double start_pts, double end_pts)
+{
+    if (!isfinite(duration) || duration <= 0 ||
+        !isfinite(clock->written + duration) ||
+        clock->written + duration <= clock->written) {
+        // A malformed output duration invalidates subsequent delay mapping.
+        mp_queued_pts_reset(clock);
+        return;
+    }
+    bool valid = known(start_pts) && known(end_pts);
+    if (!valid)
+        start_pts = end_pts = MP_NOPTS_VALUE;
+
+    struct mp_queued_pts_segment *last = clock->count
+        ? &clock->segments[index_at(clock, clock->count - 1)] : NULL;
+    bool merge = last && valid && known(last->pts_start) &&
+        fabs(last->pts_end - start_pts) < 1e-7 &&
+        fabs((last->pts_end - last->pts_start) /
+             (last->output_end - last->output_start) -
+             (end_pts - start_pts) / duration) < 1e-7;
+    // Explicit unknown segments are barriers: never join known media across
+    // timestamp-less output. Consecutive unknown segments can still coalesce.
+    merge |= last && !valid && !known(last->pts_start);
+    double start_output = clock->written;
+    clock->written += duration;
+    if (merge) {
+        last->output_end = clock->written;
+        last->pts_end = end_pts;
+        return;
+    }
+    if (clock->count == MP_QUEUED_PTS_CAPACITY) {
+        clock->first = index_at(clock, 1);
+        clock->count--;
+    }
+    clock->segments[index_at(clock, clock->count)] =
+        (struct mp_queued_pts_segment){start_output, clock->written, start_pts, end_pts};
+    clock->count++;
+}
+
+double mp_queued_pts_get(const struct mp_queued_pts *clock, double delay)
+{
+    if (!isfinite(delay) || delay < 0)
+        return MP_NOPTS_VALUE;
+    double output = clock->written - delay;
+    for (int n = clock->count - 1; n >= 0; n--) {
+        const struct mp_queued_pts_segment *s = &clock->segments[index_at(clock, n)];
+        // Admit only sub-sample arithmetic error from separately accumulated
+        // frame durations and AO sample totals (paused-start regression).
+        const double epsilon = 1e-9;
+        if (output >= s->output_start - epsilon && output <= s->output_end + epsilon) {
+            if (!known(s->pts_start))
+                return MP_NOPTS_VALUE;
+            double fraction = MPCLAMP((output - s->output_start) /
+                (s->output_end - s->output_start), 0.0, 1.0);
+            return s->pts_start + fraction * (s->pts_end - s->pts_start);
+        }
+    }
+    return MP_NOPTS_VALUE;
+}
diff --git a/audio/queued_pts.h b/audio/queued_pts.h
new file mode 100644
index 0000000..2e0b989
--- /dev/null
+++ b/audio/queued_pts.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Experimental VSF audio timing change for mpv.
+
+#pragma once
+
+// Owned by the player thread. Durations are output seconds after resampling;
+// PTS endpoints are source media seconds, including the frame's speed mapping.
+#define MP_QUEUED_PTS_CAPACITY 8192
+
+struct mp_queued_pts_segment {
+    double output_start, output_end;
+    double pts_start, pts_end;
+};
+
+struct mp_queued_pts {
+    struct mp_queued_pts_segment segments[MP_QUEUED_PTS_CAPACITY];
+    int first, count;
+    double written;
+};
+
+// Reset only when the corresponding AO queue is flushed or replaced.
+void mp_queued_pts_reset(struct mp_queued_pts *clock);
+void mp_queued_pts_append(struct mp_queued_pts *clock, double output_duration,
+                          double start_pts, double end_pts);
+// Returns MP_NOPTS_VALUE for an uncovered/unknown interval or invalid delay.
+double mp_queued_pts_get(const struct mp_queued_pts *clock, double output_delay);

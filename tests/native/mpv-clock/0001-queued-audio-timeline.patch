diff --git a/test/queued_pts.c b/test/queued_pts.c
new file mode 100644
index 0000000..2fb8c17
--- /dev/null
+++ b/test/queued_pts.c
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Experimental VSF audio timing change for mpv.
+
+#include "audio/queued_pts.h"
+#include "test_utils.h"
+
+int main(void)
+{
+    struct mp_queued_pts c = {0};
+    assert_true(mp_queued_pts_get(&c, 0) == MP_NOPTS_VALUE);
+    mp_queued_pts_append(&c, 1, 100, 101);
+    mp_queued_pts_append(&c, 1, 101, 102);
+    assert_int_equal(c.count, 1);
+    assert_float_equal(mp_queued_pts_get(&c, .5), 101.5, 1e-12);
+    assert_float_equal(mp_queued_pts_get(&c, 2 + 5e-10), 100, 1e-12);
+    assert_true(mp_queued_pts_get(&c, 2 + 2e-9) == MP_NOPTS_VALUE);
+
+    // Retained non-flushing loop seeks and lead-in use actual queued history.
+    mp_queued_pts_append(&c, 1, 100, 101);
+    assert_int_equal(c.count, 2);
+    assert_float_equal(mp_queued_pts_get(&c, 1.5), 101.5, 1e-12);
+    assert_float_equal(mp_queued_pts_get(&c, .5), 100.5, 1e-12);
+    assert_float_equal(mp_queued_pts_get(&c, 1), 100, 1e-12);
+
+    // Output speed changes may coexist in the device queue.
+    mp_queued_pts_append(&c, 2, 101, 102);
+    assert_float_equal(mp_queued_pts_get(&c, 1), 101.5, 1e-12);
+    assert_float_equal(mp_queued_pts_get(&c, 2.5), 100.5, 1e-12);
+    mp_queued_pts_append(&c, 1, 102, 100); // Reverse source interval.
+    assert_float_equal(mp_queued_pts_get(&c, .25), 100.5, 1e-12);
+
+    // Output replacement/flush invalidates the old media timeline.
+    mp_queued_pts_reset(&c);
+    assert_true(mp_queued_pts_get(&c, 0) == MP_NOPTS_VALUE);
+    mp_queued_pts_append(&c, 1, 0, 1);
+    mp_queued_pts_append(&c, 1, MP_NOPTS_VALUE, MP_NOPTS_VALUE);
+    mp_queued_pts_append(&c, 1, 1, 2);
+    assert_int_equal(c.count, 3);
+    assert_float_equal(mp_queued_pts_get(&c, 2.5), .5, 1e-12);
+    assert_true(mp_queued_pts_get(&c, 1.5) == MP_NOPTS_VALUE);
+    assert_float_equal(mp_queued_pts_get(&c, .5), 1.5, 1e-12);
+
+    // A partial/NaN timestamp invalidates that segment, not older history.
+    mp_queued_pts_append(&c, 1, NAN, 4);
+    mp_queued_pts_append(&c, 1, 4, MP_NOPTS_VALUE);
+    assert_int_equal(c.count, 4);
+    assert_true(mp_queued_pts_get(&c, .5) == MP_NOPTS_VALUE);
+    assert_float_equal(mp_queued_pts_get(&c, 2.5), 1.5, 1e-12);
+    assert_true(mp_queued_pts_get(&c, -1) == MP_NOPTS_VALUE);
+    assert_true(mp_queued_pts_get(&c, NAN) == MP_NOPTS_VALUE);
+    assert_true(mp_queued_pts_get(&c, INFINITY) == MP_NOPTS_VALUE);
+    mp_queued_pts_append(&c, NAN, 0, 1);
+    assert_int_equal(c.count, 0);
+    mp_queued_pts_append(&c, 0, 0, 0);
+    assert_int_equal(c.count, 0);
+    mp_queued_pts_append(&c, DBL_MAX / 2, 0, 1);
+    mp_queued_pts_append(&c, 1, 1, 2); // Duration no longer representable.
+    assert_int_equal(c.count, 0);
+
+    // Exhausted history is unavailable; no guessing/modulo and no growth.
+    for (int n = 0; n < MP_QUEUED_PTS_CAPACITY + 10; n++)
+        mp_queued_pts_append(&c, 1, 100, 101);
+    assert_int_equal(c.count, MP_QUEUED_PTS_CAPACITY);
+    assert_true(mp_queued_pts_get(&c, MP_QUEUED_PTS_CAPACITY + .5) == MP_NOPTS_VALUE);
+    assert_float_equal(mp_queued_pts_get(&c, MP_QUEUED_PTS_CAPACITY - .5), 100.5, 1e-12);
+    assert_float_equal(mp_queued_pts_get(&c, .5), 100.5, 1e-12);
+    mp_queued_pts_reset(&c);
+    mp_queued_pts_append(&c, .25, 3, 3.5);
+    assert_float_equal(mp_queued_pts_get(&c, .125), 3.25, 1e-12);
+    return 0;
+}

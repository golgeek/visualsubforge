+// Control thread only. The buffer lock excludes a pull callback while reading
+// pending samples; pause keeps callbacks from consuming data after this read.
+// Driver/device buffering is deliberately excluded.
+double ao_get_unsubmitted_duration(struct ao *ao)
+{
+    struct buffer_state *p = ao->buffer_state;
+    mp_mutex_lock(&p->lock);
+    double duration = NAN;
+    if (p->paused && !ao->driver->write && af_fmt_is_pcm(ao->format)) {
+        int64_t samples = mp_async_queue_get_samples(p->queue);
+        if (p->pending)
+            samples += mp_aframe_get_size(p->pending);
+        duration = samples / (double)ao->samplerate;
+    }
+    mp_mutex_unlock(&p->lock);
+    return duration;
 }
 

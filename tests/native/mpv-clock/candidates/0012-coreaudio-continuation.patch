+// Local continuation contract, deliberately restricted to the tested retained-
+// output backend. Other drivers can discard submitted output on reset, so the
+// same queue snapshot is not a portable restart policy. Called on the core owner.
+double audio_continuation_pts(struct MPContext *mpctx)
+{
+    struct ao_chain *c = mpctx->ao_chain;
+    if (!mpctx->playback_initialized || !mpctx->paused || !mpctx->ao || !c ||
+        strcmp(ao_get_name(mpctx->ao), "coreaudio") != 0)
+        return MP_NOPTS_VALUE;
+    return mp_queued_pts_continuation(&c->clock,
+                                     ao_get_unsubmitted_duration(mpctx->ao));
+}

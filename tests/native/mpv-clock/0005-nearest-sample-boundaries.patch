diff --git a/test/aframe_clip.c b/test/aframe_clip.c
new file mode 100644
index 0000000..f9a6287
--- /dev/null
+++ b/test/aframe_clip.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Experimental VSF audio timing change for mpv.
+
+#include "audio/aframe.h"
+#include "audio/chmap.h"
+#include "audio/format.h"
+#include "test_utils.h"
+
+static void check(int rate, double speed, double pts, double start, double end,
+                  int first, int count)
+{
+    struct mp_aframe *f = mp_aframe_create();
+    struct mp_chmap channels;
+    mp_chmap_from_channels(&channels, 1);
+    assert_true(mp_aframe_set_format(f, AF_FORMAT_S16));
+    assert_true(mp_aframe_set_chmap(f, &channels));
+    assert_true(mp_aframe_set_rate(f, rate));
+    mp_aframe_set_speed(f, speed);
+    mp_aframe_set_pts(f, pts);
+    assert_true(mp_aframe_alloc_data(f, 4096));
+    int16_t *data = (int16_t *)mp_aframe_get_data_rw(f)[0];
+    for (int n = 0; n < 4096; n++)
+        data[n] = n;
+    double effective = mp_aframe_get_effective_rate(f);
+    mp_aframe_clip_timestamps(f,
+        start == MP_NOPTS_VALUE ? start : pts + start / effective,
+        end == MP_NOPTS_VALUE ? end : pts + end / effective);
+    assert_int_equal(mp_aframe_get_size(f), count);
+    if (count) {
+        const int16_t *result = (const int16_t *)mp_aframe_get_data_ro(f)[0];
+        assert_int_equal(result[0], first);
+        assert_int_equal(result[count - 1], first + count - 1);
+        assert_float_equal(mp_aframe_get_pts(f), pts + first / effective, 1e-10);
+    }
+    talloc_free(f);
+}
+
+int main(void)
+{
+    int rates[] = {8000, 44100, 48000, 96000};
+    double speeds[] = {.5, 1, 1.5};
+    double origins[] = {0, 1.001, 7198.93};
+    for (int r = 0; r < MP_ARRAY_SIZE(rates); r++) {
+        for (int s = 0; s < MP_ARRAY_SIZE(speeds); s++) {
+            for (int o = 0; o < MP_ARRAY_SIZE(origins); o++) {
+                int rate = rates[r]; double speed = speeds[s], pts = origins[o];
+                check(rate, speed, pts, 104, 2688, 104, 2584);
+                check(rate, speed, pts, 10.49, 100.49, 10, 90);
+                check(rate, speed, pts, 10.51, 100.51, 11, 90);
+                check(rate, speed, pts, 0, 4096, 0, 4096);
+                check(rate, speed, pts, -10, 4097, 0, 4096);
+                check(rate, speed, pts, 4096, 5000, 0, 0);
+                check(rate, speed, pts, -10, 0, 0, 0);
+                check(rate, speed, pts, 100, 100, 0, 0);
+                check(rate, speed, pts, 101, 100, 0, 0);
+                check(rate, speed, pts, MP_NOPTS_VALUE, MP_NOPTS_VALUE, 0, 4096);
+            }
+        }
+    }
+    // Exact binary half-sample ties round forward at both endpoints.
+    check(8192, 1, 0, 10.5, 100.5, 11, 90);
+    return 0;
+}

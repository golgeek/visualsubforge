+// Return a deadline only when a pull output has consumed its source queue but
+// still has a presentation deadline. No callback is guaranteed at that deadline.
+// Otherwise the AO notifies the player when its playing state changes; -1 means
+// wait for that notification. In particular, zero push-output delay can precede
+// its EOF notification and must not turn into a player-thread busy loop.
+double ao_get_drain_timeout(struct ao *ao)
+{
+    struct buffer_state *p = ao->buffer_state;
+    mp_mutex_lock(&p->lock);
+    double timeout = -1;
+    if (!ao->driver->write && !p->playing && !p->paused)
+        timeout = MPMAX(0, MP_TIME_NS_TO_S(p->end_time_ns - mp_time_ns()));
+    mp_mutex_unlock(&p->lock);
+    return timeout;
+}

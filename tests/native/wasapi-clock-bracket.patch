+static void vsf_clock_bracket(struct ao *ao, int phase)
+{
+    LARGE_INTEGER frequency, before, after;
+    if (!QueryPerformanceFrequency(&frequency)) return;
+    for (int i = 0; i < 8; i++) {
+        if (!QueryPerformanceCounter(&before)) return;
+        int64_t mp_ns = mp_time_ns();
+        if (!QueryPerformanceCounter(&after)) return;
+        MP_WARN(ao, "VSF_CLOCK_BRACKET phase=%d qpc_before=%lld qpc_after=%lld frequency=%lld mp_ns=%"PRId64"\n",
+                phase, (long long)before.QuadPart, (long long)after.QuadPart,
+                (long long)frequency.QuadPart, mp_ns);
+    }
+}
+

 static WIN32_ALLOCATOR: Heapalloc = Heapalloc;

 pub struct Heapalloc;

+// HeapAlloc guarantees 8-byte alignment on Win32 and 16 bytes on Win64.
+// Larger Rust alignments need padding and the original pointer for HeapFree.
+const HEAP_ALIGNMENT: usize = 2 * size_of::<usize>();
+
+impl Heapalloc {
+    unsafe fn allocate(&self, layout: Layout, flags: u32) -> *mut u8 {
+        if layout.align() <= HEAP_ALIGNMENT {
+            return HeapAlloc(GetProcessHeap(), flags, layout.size()).cast();
+        }
+        let Some(size) = layout.size().checked_add(layout.align()) else {
+            return core::ptr::null_mut();
+        };
+        if size > isize::MAX as usize {
+            return core::ptr::null_mut();
+        }
+        let raw: *mut u8 = HeapAlloc(GetProcessHeap(), flags, size).cast();
+        if raw.is_null() {
+            return raw;
+        }
+        let offset = layout.align() - (raw as usize & (layout.align() - 1));
+        // Both alignments are powers of two. offset leaves at least one
+        // pointer-sized, aligned slot before the returned allocation.
+        let aligned = raw.add(offset);
+        aligned.cast::<*mut u8>().sub(1).write(raw);
+        aligned
+    }
+}

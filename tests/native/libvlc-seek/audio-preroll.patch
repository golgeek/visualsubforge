--- /dev/null
+++ b/src/input/audio_preroll.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Experimental input-core audio preroll metadata and decoded PCM trimming.
+ */
+#ifndef VLC_INPUT_AUDIO_PREROLL_H
+#define VLC_INPUT_AUDIO_PREROLL_H
+#include <vlc_common.h>
+#include <vlc_aout.h>
+#include <vlc_frame.h>
+
+#define VLC_INPUT_AUDIO_PREROLL VLC_ANCILLARY_ID('v', 's', 'p', 'r')
+
+/* Return false when this entire PCM block is before the target or malformed.
+ * The caller retains ownership and releases a rejected block. Unsupported
+ * passthrough formats retain their existing behavior; no precision is claimed.
+ * Caller holds the decoder FIFO lock. Only the payload view is advanced;
+ * the frame's allocation/release callback remains unchanged.
+ */
+static inline bool
+vlc_audio_preroll_Trim(vlc_frame_t *frame, const audio_sample_format_t *fmt,
+                      vlc_tick_t target)
+{
+    if (target == VLC_TICK_INVALID || frame->i_pts >= target || !AOUT_FMT_LINEAR(fmt))
+        return true;
+    if (frame->i_pts == VLC_TICK_INVALID || fmt->i_rate == 0 ||
+        fmt->i_frame_length != 1 || fmt->i_bytes_per_frame == 0 ||
+        frame->i_nb_samples == 0 ||
+        frame->i_nb_samples > frame->i_buffer / fmt->i_bytes_per_frame)
+        return false;
+
+    /* Split before multiplying, including for hostile/extreme timestamps.
+     * Round to the nearest sample, with exact ties forward, matching the
+     * editor transport contract (at most half a sample of quantization).
+     */
+    const uint64_t delta = (uint64_t) target - (uint64_t) frame->i_pts;
+    const uint64_t seconds = delta / CLOCK_FREQ;
+    if (seconds > frame->i_nb_samples / fmt->i_rate)
+        return false;
+    const uint64_t samples = seconds * fmt->i_rate +
+        ((delta % CLOCK_FREQ) * fmt->i_rate + CLOCK_FREQ / 2) / CLOCK_FREQ;
+    if (samples >= frame->i_nb_samples || samples > frame->i_buffer / fmt->i_bytes_per_frame)
+        return false;
+
+    const size_t bytes = samples * fmt->i_bytes_per_frame;
+    const vlc_tick_t advance = vlc_tick_from_samples(samples, fmt->i_rate);
+    if (frame->i_pts > VLC_TICK_MAX - advance ||
+        (frame->i_dts != VLC_TICK_INVALID && frame->i_dts > VLC_TICK_MAX - advance))
+        return false;
+    frame->p_buffer += bytes;
+    frame->i_buffer -= bytes;
+    frame->i_nb_samples -= samples;
+    frame->i_pts += advance;
+    if (frame->i_dts != VLC_TICK_INVALID)
+        frame->i_dts += advance;
+    frame->i_length = vlc_tick_from_samples(frame->i_nb_samples, fmt->i_rate);
+    return true;
+}
+#endif
